# Пример настроек для локального запуска без Docker: скопируйте в .env в этой папке.
# В Docker Compose общие переменные (SECRET_KEY, ALGORITHM и др.) берутся из корневого .env
# (создаётся ./scripts/init-env.sh, шаблон — корневой .env.example), остальное задано в docker-compose.yml.
# В Kubernetes переменные задаются в k8s/.

# Адреса внутренних сервисов
AUTH_URL=http://127.0.0.1:8001
TASK_URL=http://127.0.0.1:8002
TIME_URL=http://127.0.0.1:8003

# Обязательна, без неё сервис не стартует. Один и тот же ключ во всех бэкенд-сервисах.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Алгоритм подписи JWT, одинаковый во всех сервисах
ALGORITHM=HS256

# Origin'ы фронтенда, которым разрешены запросы из браузера (CORS), через запятую.
# По умолчанию http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
