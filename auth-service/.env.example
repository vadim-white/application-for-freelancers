# Пример настроек для локального запуска без Docker: скопируйте в .env в этой папке.
# В Docker Compose и Kubernetes переменные задаются в docker-compose.yml и k8s/.

# Обязательна, без неё сервис не стартует. Строка подключения SQLAlchemy.
# PostgreSQL: postgresql+psycopg://user:password@host:5432/auth_db
# SQLite для локального запуска без Docker:
DATABASE_URL=sqlite:///./auth.db

# Обязательна, без неё сервис не стартует. Один и тот же ключ во всех бэкенд-сервисах.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Алгоритм подписи JWT, одинаковый во всех сервисах
ALGORITHM=HS256

# Время жизни токенов в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# true — при старте создать тестовых пользователей с паролем password123. Только для разработки
SEED_TEST_USERS=false
