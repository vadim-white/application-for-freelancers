# Общие настройки Docker Compose. Файл .env создаёт ./scripts/init-env.sh
# (копирует этот шаблон и подставляет случайные секреты); .env в git не попадает.

# Ключ подписи JWT, один на все сервисы. Пусто здесь — генерирует init-env.sh.
# Без него docker compose не стартует.
SECRET_KEY=
# Алгоритм подписи JWT
ALGORITHM=HS256
# Время жизни access-токена в минутах
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Пароли баз данных (у каждой БД свой пользователь). Пусто здесь — генерирует init-env.sh.
# Только символы [A-Za-z0-9_-]: пароль подставляется в DATABASE_URL, а @ : / его ломают.
# Применяются при создании тома БД: после смены на существующем томе нужен docker compose down -v.
AUTH_DB_PASSWORD=
TASK_DB_PASSWORD=
TIME_DB_PASSWORD=

# Origin'ы фронтенда, которым gateway разрешает запросы из браузера (CORS), через запятую
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Только для разработки: true — контейнер ser-auth-seed создаёт admin@example.com,
# user1@example.com, user2@example.com с паролем password123. smoke опирается на них.
SEED_TEST_USERS=true
