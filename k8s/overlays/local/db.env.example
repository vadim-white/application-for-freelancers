# Пароли баз для локального кластера kind -> Secret db-credentials.
# Рабочий db.env создаёт scripts/init-k8s-env.sh (подставляет случайные значения); в git не попадает.
# Только символы [A-Za-z0-9_-]: пароль подставляется в DATABASE_URL, а @ : / его ломают.
# Пароль применяется при первом создании тома БД; после смены на существующем томе нужно удалить
# namespace вместе с PVC (kubectl --context kind-freelance delete namespace freelance-service) и применить заново.
AUTH_DB_PASSWORD=
TASK_DB_PASSWORD=
TIME_DB_PASSWORD=
