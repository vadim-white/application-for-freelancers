# Секреты приложений для локального кластера kind -> Secret app-secrets.
# Рабочий app.env создаёт scripts/init-k8s-env.sh (подставляет случайные значения); в git не попадает.
# Секреты кластера независимы от корневого .env для compose. Только символы [A-Za-z0-9_-].
# Ключ подписи JWT, один на все сервисы
SECRET_KEY=
